{
  "name": "app-world-chess",
  "version": "0.1.0",
  "private": true,
  "homepage": "https://app-world-chess.vercel.app/",
  "dependencies": {
    "@reduxjs/toolkit": "^2.12.0",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.7",
    "ajv": "^8.17.1",
    "colyseus.js": "^0.16.22",
    "formik": "^2.4.9",
    "modern-normalize": "^3.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-media": "^1.10.0",
    "react-redux": "^9.3.0",
    "react-router-dom": "^6.30.4",
    "react-scripts": "5.0.1",
    "react-toastify": "^11.0.5",
    "react-use-websocket": "^4.6.1",
    "redux-persist": "^6.0.0",
    "spinners-react": "^1.0.11",
    "yup": "^1.7.1"
  },
  "scripts": {
    "start": "react-app-rewired start",
    "dev": "concurrently \"npm:start\" \"npm:lint:watch\"",
    "build": "react-app-rewired build",
    "eject": "react-scripts eject",
    "lint:js": "eslint src/**/*.{js,jsx,tsx,ts}",
    "lint:fix": "eslint --fix src/**/*.{js,jsx,tsx,ts}",
    "lint:watch": "eslint --watch src/**/*.{js,jsx,tsx,ts}",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,css,scss,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx,css,scss,json,md}\""
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "prettier"
    ],
    "parser": "@typescript-eslint/parser",
    "parserOptions": {
      "ecmaVersion": "latest",
      "sourceType": "module",
      "projectService": true
    },
    "plugins": [
      "react-refresh"
    ],
    "rules": {
      "react-refresh/only-export-components": [
        "warn",
        {
          "allowConstantExport": true
        }
      ],
      "@typescript-eslint/no-explicit-any": "warn",
      "@typescript-eslint/no-unused-vars": [
        "warn",
        {
          "argsIgnorePattern": "^_"
        }
      ],
      "@typescript-eslint/no-non-null-assertion": "off",
      "react-hooks/rules-of-hooks": "error",
      "react-hooks/exhaustive-deps": "warn"
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all",
      "not ie 11"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "concurrently": "^10.0.4",
    "customize-cra": "^1.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "prettier": "^3.6.0",
    "react-app-rewired": "^2.2.1",
    "typescript": "^5.9.3"
  }
}
